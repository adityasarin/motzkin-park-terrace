# Copy to .env.local and fill in. Every value is optional for local runs.

# Public URL used in canonical links, schema, sitemap and llms.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact (TODO-VERIFY with the developer)
NEXT_PUBLIC_PHONE=+91 80000 00000
NEXT_PUBLIC_WHATSAPP=918000000000

# Google Tag Manager container (GA4, Google Ads, Meta Pixel live inside it). Leave empty to load no tags.
NEXT_PUBLIC_GTM_ID=

# Lead storage: Google Apps Script web app (apps-script/lead-sheet.gs). Without it, leads go to site/.data/leads.ndjson.
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

# Meta Conversions API (server-side Lead event, deduplicated with the Pixel by event_id)
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# Set to 1 to serve /design-qa in a production build
ENABLE_DESIGN_QA=
